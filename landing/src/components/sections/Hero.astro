---
import HeroVideo from './HeroVideo.astro'
import Badge from '../ui/Badge.astro'
import Button from '../ui/Button.astro'
import Icon from '../ui/Icon.astro'
import { heroWords, site } from '../../data/site'

/**
 * Hero.
 *
 * Sin recurso visual al lado. Se intentó tres veces y las tres estorbaron: un
 * mockup del panel parecía una captura falsa, una lista de palabras flotando
 * no decía nada, y un racimo de cubos no significaba nada para quien no conoce
 * el producto. Un hueco honesto se lee como decisión de diseño; un adorno que
 * no explica nada se lee como relleno.
 *
 * Lo que hace el trabajo es la tipografía: un titular grande, una sola
 * columna, y todo el aire alrededor. El fondo lleva la toma de `HeroVideo`,
 * un velo de papel que la mantiene legible, y los halos de marca por encima;
 * dan profundidad sin fingir ser una interfaz.
 *
 * Sobre el titular:
 *
 * 1. Usa el contraste de peso del `login-showcase` del panel, pero **atenuado**
 *    a `font-normal` ↔ `font-semibold`. El panel puede permitirse
 *    `font-light` ↔ `font-extrabold` porque su titular va en mayúsculas y
 *    ocupa dos líneas cortas; con ese salto a un titular en minúsculas, el
 *    resultado se lee como dos tipografías pegadas. El recurso se conserva, la
 *    distancia se recorta.
 *
 * 2. La última línea rota entre términos que el propio panel usa
 *    (`condominios` es su descripción; las otras tres son módulos reales). Es
 *    lo que quita la rigidez de la primera pantalla: algo se mueve solo, muy
 *    despacio, y la versión estática completa se expone a lectores de pantalla
 *    con `sr-only`.
 *
 * Los CTA apuntan al canal que ya usa el panel (`support-links.ts`). El acceso
 * al panel solo se renderiza si `PUBLIC_PANEL_URL` está definido en el build:
 * es preferible que falte un enlace a apuntar a un sitio equivocado.
 */
---

<section
	aria-labelledby="hero-title"
	class="relative isolate overflow-hidden bg-canvas pt-[calc(var(--header-height)+5rem)] pb-24 sm:pb-32 lg:pt-[calc(var(--header-height)+7rem)]"
	data-hero
>
	{/*
		Fondo. El video entra primero y los halos de marca van encima: como la
		toma es en escala de grises, el teal tiene que venir de aquí para que el
		hero no se lea como una foto ajena a la paleta.

		Los halos dan profundidad sin contenido. Los periodos son largos y
		primos entre sí para que la composición nunca se repita a la vista, y van
		en `motion-safe` porque con movimiento reducido basta con que estén
		quietos.

		Los halos se quedan en alfa, sin `mix-blend`: multiplicar oscurecería el
		video justo debajo y el fondo es lo que se quiere ver, no lo que se
		quiere atenuar. Bajo el velo de papel su alfa baja de 35%/45% a
		30%/40%, porque ahora se suman al velo en vez de estar solos.

		La trama de puntos sí se retira: sobre imagen en movimiento produce
		moiré, y un patrón que titila se lee como ruido.
	*/}
	<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
		<HeroVideo />

		<div
			class="absolute -top-40 left-1/2 size-[46rem] -translate-x-1/2 rounded-full bg-brand-200/30 blur-[130px] motion-safe:animate-halo-a"
		>
		</div>
		<div
			class="absolute -bottom-52 left-1/4 size-[34rem] rounded-full bg-brand-100/40 blur-[120px] motion-safe:animate-halo-b"
		>
		</div>
	</div>

	<div class="container-page relative">
		<div class="mx-auto flex max-w-3xl flex-col items-center text-center">
			<div class="animate-rise">
				<Badge label="Producto en construcción activa" icon="sparkle" />
			</div>

			<h1
				id="hero-title"
				class="mt-7 text-[clamp(2.4rem,6.2vw,4.5rem)] leading-[1.05] font-normal tracking-[-0.03em] text-balance text-zinc-950"
			>
				{/*
					Una sola columna y dos líneas. Con "de" en su propia línea el
					bloque se leía desproporcionado —una línea larga y dos de una
					palabra—, así que la primera línea sostiene el marco y la
					segunda lleva el peso, que es donde tiene que estar la atención.
				*/}
				<span class="block animate-rise">Gestión moderna de</span>

				{/*
					La línea rotativa reserva su alto con `min-height`: sin él, el
					salto al cambiar de palabra movería todo lo que hay debajo.
				*/}
				<span
					class="mt-1 block min-h-[1.05em] animate-rise font-semibold text-brand-800"
					style="animation-delay:140ms"
					data-hero-rotator
					data-words={heroWords.join('|')}
				>
					{/*
						Contenedor accesible con la frase completa y estática. Lo
						animado es `aria-hidden`: rotar un titular con `aria-live`
						dispararía el lector en cada cambio.
					*/}
					<span class="sr-only">Gestión moderna de {heroWords.join(', ')} y más.</span>
					<span aria-hidden="true" data-hero-word class="block">{heroWords[0]}</span>
				</span>
			</h1>

			<p
				class="mt-7 max-w-[52ch] text-[1.0625rem] leading-relaxed text-pretty text-zinc-600"
				data-reveal="up"
				style="--i:1"
			>
				Condora organiza el padrón, las cuotas, los pagos y los indicadores de cobranza
				de tu condominio en un solo lugar. Sin perseguir a nadie.
			</p>

			<div
				class="mt-9 flex flex-col items-center gap-3 sm:flex-row"
				data-reveal="up"
				style="--i:2"
			>
				<Button href={site.requestDemoHref} variant="primary" size="lg">
					Solicita una demo
				</Button>
				{
					site.panelUrl && (
						<Button href={site.panelUrl} variant="outline" size="lg">
							Ir al panel
						</Button>
					)
				}
			</div>

			<ul
				class="mt-9 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[0.8125rem] text-zinc-500"
				data-reveal="up"
				style="--i:3"
			>
				<li class="inline-flex items-center gap-1.5">
					<Icon name="check" class="size-4 text-brand-700" weight={2.25} />
					Datos de ejemplo en la demo
				</li>
				<li class="inline-flex items-center gap-1.5">
					<Icon name="check" class="size-4 text-brand-700" weight={2.25} />
					Sin tarjeta de crédito
				</li>
			</ul>
		</div>
	</div>
</section>

<script>
	/**
	 * Rotador del titular.
	 *
	 * Ritmo: 3.2 s de lectura + 0.62 s de cambio. El cambio sube 10 px y se
	 * desvanece mientras entra la siguiente. Con una duración mayor se percibe
	 * como animación; con una menor, como parpadeo.
	 *
	 * Se detiene si el puntero está sobre el titular o si la pestaña deja de
	 * estar en primer plano, y no arranca nunca con `prefers-reduced-motion`: en
	 * ese caso la palabra se queda quieta y el titular sigue siendo una frase
	 * completa.
	 */
	const rotator = document.querySelector<HTMLElement>('[data-hero-rotator]')
	const wordSlot = rotator?.querySelector<HTMLElement>('[data-hero-word]')

	if (rotator && wordSlot) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)')
		const words = (rotator.dataset.words ?? '').split('|').filter(Boolean)
		const HOLD = 3200
		const OUT_MS = 300
		const IN_MS = 320

		if (words.length > 1 && !reduced.matches) {
			let index = 0
			let timer = 0
			let paused = false

			const show = (value: string, animate: boolean) => {
				if (!animate) {
					wordSlot.textContent = value
					return
				}

				wordSlot.animate(
					[
						{ opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' },
						{ opacity: 0, transform: 'translateY(-10px)', filter: 'blur(4px)' }
					],
					{
						duration: OUT_MS,
						easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
						fill: 'forwards'
					}
				)

				setTimeout(() => {
					wordSlot.textContent = value
					wordSlot.animate(
						[
							{ opacity: 0, transform: 'translateY(10px)', filter: 'blur(4px)' },
							{ opacity: 1, transform: 'translateY(0)', filter: 'blur(0)' }
						],
						{ duration: IN_MS, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'both' }
					)
				}, OUT_MS)
			}

			const advance = () => {
				index = (index + 1) % words.length
				show(words[index]!, true)
			}

			const start = () => {
				if (paused || timer) return
				timer = window.setInterval(advance, HOLD + IN_MS)
			}

			const stop = () => {
				if (!timer) return
				clearInterval(timer)
				timer = 0
			}

			rotator.addEventListener('pointerenter', () => {
				paused = true
				stop()
			})
			rotator.addEventListener('pointerleave', () => {
				paused = false
				start()
			})
			document.addEventListener('visibilitychange', () => {
				document.hidden ? stop() : start()
			})

			start()
		}
	}
</script>