---
import Icon from './Icon.astro'

/**
 * Encabezado de sección reutilizable.
 *
 * El recurso tipográfico del panel es el contraste de peso dentro de una misma
 * línea (`font-light` junto a `font-extrabold`), no una familia serif distinta.
 * Por eso `highlight` se renders como un `<strong>` en negrita dentro del
 * propio título: es el mismo gesto que en `login-showcase.tsx`.
 */
interface Props {
	kicker?: string
	title: string
	/** Fragmento del título que va en `font-extrabold`. */
	highlight?: string
	description?: string
	level?: 'h1' | 'h2'
	align?: 'left' | 'center'
	class?: string
	/** Ancho máximo del bloque de texto, en rem. */
	measure?: number
	id?: string
}

const {
	kicker,
	title,
	highlight,
	description,
	level = 'h2',
	align = 'left',
	class: className = '',
	measure = 42,
	id,
} = Astro.props

const Tag = level
---

<div
	class:list={[
		'flex flex-col gap-4',
		align === 'center' && 'items-center text-center',
		className,
	]}
	/*
	 * Cada pieza entra por separado y en orden de lectura, no el bloque entero
	 * como una sola pieza. El gesto de leer una sección va de la etiqueta al
	 * título y de ahí al texto; si el título aparece cuando todavía no se ha
	 * leído la etiqueta, el ojo llega tarde. Vive aquí y no en cada sección
	 * porque todos los encabezados deberían comportarse igual; si se deja en el
	 * marcado de cada uno, basta un forgotten para que uno se quede quieto
	 * mientras los demás entran.
	 *
	 * `--i` es la posición en la secuencia y las dos capas del sistema lo
	 * leen: milisegundos en el respaldo con `transition`, porcentaje del
	 * recorrido en la animación de scroll.
	 */
>
	{
		kicker && (
			<p class="kicker animate-on-scroll animate-slide-left duration-700 ease-out" style="transition-delay: 0ms">
				<Icon name="sparkle" class="size-3.5" />
				{kicker}
			</p>
		)
	}

	<Tag
		id={id}
		class:list={[
			'font-semibold tracking-[-0.02em] animate-on-scroll animate-slide-up duration-700 ease-out',
			level === 'h1'
				? 'text-[clamp(2.4rem,6.2vw,4.25rem)] leading-[1.04]'
				: 'text-[clamp(1.75rem,3.6vw,2.75rem)] leading-[1.1]',
		]}
		style="transition-delay: 100ms"
	>
		{highlight ? <>{title} <strong class="font-extrabold">{highlight}</strong></> : title}
	</Tag>

	{
		description && (
			<p
				class="text-[1.0625rem] leading-relaxed text-zinc-600 animate-on-scroll animate-fade duration-700 ease-out"
				style={`max-width:${measure}rem; transition-delay: 200ms`}
			>
				{description}
			</p>
		)
	}

	{/* Regla que se dibuja al entrar: el trazo crece en X, no aparece de golpe.
	    Va al final de la secuencia y por eso tarda más que el texto: cierra el
	    encabezado en vez de competir con él. */}
	<span
		class="mt-1 block h-px w-14 origin-left bg-brand-600/45 animate-on-scroll animate-slide-left duration-700 ease-out"
		style="transition-delay: 300ms; transform: scaleX(0);"
		data-animate-draw
		aria-hidden="true"
	></span>
</div>