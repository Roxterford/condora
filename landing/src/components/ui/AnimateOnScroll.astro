---
/**
 * Componente wrapper para animaciones de entrada al hacer scroll.
 * Usa Intersection Observer para activar animaciones una sola vez (once: true).
 * 
 * @param {string} as - Elemento HTML a renderizar (default: 'div')
 * @param {'fade' | 'slide-up' | 'slide-down' | 'slide-left' | 'slide-right'} animation - Tipo de animación (default: 'fade')
 * @param {number} delay - Delay en ms antes de iniciar la animación (default: 0)
 * @param {string} className - Clases adicionales de Tailwind
 * @param {string} willChange - Propiedades para will-change (default: 'transform, opacity')
 */
export interface Props {
  as?: keyof astroHTML.JSX.DefinedIntrinsicElements
  animation?: 'fade' | 'slide-up' | 'slide-down' | 'slide-left' | 'slide-right'
  delay?: number
  class?: string
  willChange?: string
  once?: boolean
}

const {
  as: Tag = 'div',
  animation = 'fade',
  delay = 0,
  class: className = '',
  willChange = 'transform, opacity',
  once = true,
} = Astro.props
---

<Tag
  class:list={[
    'animate-on-scroll',
    `animate-${animation}`,
    className,
  ]}
  data-animate-on-scroll
  data-animation={animation}
  data-delay={delay}
  data-once={once}
  style={`will-change: ${willChange};`}
>
  <slot />
</Tag>

<script>
  class AnimateOnScroll extends HTMLElement {
    private observer?: IntersectionObserver

    connectedCallback() {
      const animation = this.dataset.animation || 'fade'
      const delay = parseInt(this.dataset.delay || '0')
      const once = this.dataset.once !== 'false'

      // Estado inicial
      this.classList.add(`animate-${animation}-initial`)

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              setTimeout(() => {
                this.classList.remove(`animate-${animation}-initial`)
                this.classList.add('animate-active')
              }, delay)

              if (once) {
                observer.unobserve(entry.target)
              }
            } else if (!once) {
              this.classList.add(`animate-${animation}-initial`)
              this.classList.remove('animate-active')
            }
          })
        },
        {
          threshold: 0.1,
          rootMargin: '0px 0px -50px 0px',
        }
      )

      observer.observe(this)
      this.observer = observer
    }

    disconnectedCallback() {
      this.observer?.disconnect()
    }
  }

  customElements.define('animate-on-scroll', AnimateOnScroll)
</script>