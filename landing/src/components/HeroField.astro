---
import { modules } from '../data/site'

/**
 * Campo visual del hero.
 *
 * Sustituye al mini-panel de administración que había antes. Ese panel se
 * veía como una maqueta falsa —y además anunciaba un módulo que no existe—,
 * así que aquí no hay ninguna interfaz simulada: solo los nombres reales de
 * los módulos, tipográficos, flotando.
 *
 * Por qué funciona mejor que un panel:
 *
 * - No finge ser producto. Solo repite términos que el panel ya usa, y esa
 *   misma lista se desarrolla abajo en Módulos, así que no oculta nada.
 * - Se mueve sin pedir atención: dos columnas a velocidades distintas, muy
 *   lentas, en vaivén. Es atmósfera, no información.
 * - Es decorativo de verdad (`aria-hidden`), así que a los lectores de pantalla
 *   no les llega ruido repetido.
 *
 * Sobre el movimiento: antes las columnas subían en bucle con
 * `translateY(-50%)`. Eso no cerraba bien, porque el -50% se calcula sobre la
 * altura del elemento estirado por flexbox y no sobre una copia de la lista;
 * al cambiar la altura del hero aparecía una costura. Ahora el vaivén
 * alterno no tiene empalme que resolver, así que es immune a cualquier
 * viewport.
 *
 * El brillo que sigue al puntero va por requestAnimationFrame: se guarda la
 * última posición y se aplica en el siguiente frame, en vez de escribir el
 * estilo en cada `pointermove`.
 *
 * Este bloque está pensado como ranura del futuro video hero: el vídeo puede
 * ocupar este mismo lugar sin tocar el copy de la izquierda.
 */

/** La segunda columna arranca desfasada media altura para que no se alineen. */
const flipped = [...modules].reverse()
---

<div
	class="hero-field pointer-events-none absolute inset-0 overflow-hidden"
	aria-hidden="true"
	data-hero-field
>
	<!-- Rejilla de puntos: da textura sin robar atención -->
	<div
		class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--color-zinc-950)_1px,transparent_1px)] opacity-[0.07]"
		style="background-size:26px 26px"
	></div>

	<!-- Halos de marca. Derivan en direcciones opuestas y con periodos
	     primos entre sí, así que nunca se repiten a la vista. -->
	<div class="absolute -top-24 -right-16 size-[30rem] rounded-full bg-brand-200/40 blur-[100px] motion-safe:animate-drift-a"></div>
	<div class="absolute top-1/3 -left-20 size-[24rem] rounded-full bg-brand-100/50 blur-[90px] motion-safe:animate-drift-b"></div>

	<!-- Columnas de módulos -->
	<div class="absolute inset-y-0 right-0 flex w-full px-2 lg:w-[46%] lg:px-0">
		<div
			class="hero-field__column flex h-full w-1/2 flex-col justify-around gap-6 [mask-image:linear-gradient(to_bottom,transparent,#000_20%,#000_80%,transparent)] motion-safe:animate-float-a"
		>
			{
				modules.map((module) => (
					<span class="flex items-center gap-2.5 whitespace-nowrap text-[0.9375rem] font-medium text-zinc-400">
						<span class="size-1.5 shrink-0 rounded-full bg-brand-500/70" />
						{module.title}
					</span>
				))
			}
		</div>

		<div
			class="hero-field__column flex h-full w-1/2 translate-y-[22%] flex-col justify-around gap-6 opacity-70 [mask-image:linear-gradient(to_bottom,transparent,#000_28%,#000_72%,transparent)] motion-safe:animate-float-b"
		>
			{
				flipped.map((module) => (
					<span class="flex items-center justify-end gap-2.5 whitespace-nowrap text-[0.9375rem] font-medium text-zinc-300">
						{module.title}
						<span class="size-1.5 shrink-0 rounded-full bg-zinc-300" />
					</span>
				))
			}
		</div>
	</div>

	<!-- Brillo que sigue al puntero -->
	<div
		class="hero-field__glow absolute size-[26rem] rounded-full bg-brand-300/25 blur-[80px] opacity-0 transition-opacity duration-1000 ease-brand"
		data-hero-glow
	></div>

	<!-- Viñeta: difumina los bordes para que el campo no tenga borde visible -->
	<div
		class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_35%,var(--color-background)_88%)]"
	></div>
</div>

<script>
	const field = document.querySelector<HTMLElement>('[data-hero-field]');
	const glow = document.querySelector<HTMLElement>('[data-hero-glow]');

	if (field && glow) {
		const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

		if (!reduced.matches) {
			// Se guarda la última posición conocida y se aplica en el frame
			// siguiente: `pointermove` dispara muchas más veces que los
			// frames disponibles, y escribir el estilo en cada evento fuerza
			// reflow innecesario.
			let px = 0;
			let py = 0;
			let raf = 0;

			const apply = () => {
				raf = 0;
				glow.style.transform = `translate3d(${px - 208}px, ${py - 208}px, 0)`;
				glow.style.opacity = '1';
			};

			field.addEventListener('pointermove', (event) => {
				px = event.clientX;
				py = event.clientY;
				if (!raf) raf = requestAnimationFrame(apply);
			});

			field.addEventListener('pointerleave', () => {
				if (!raf) return;
				cancelAnimationFrame(raf);
				raf = 0;
				glow.style.opacity = '0';
			});
		}
	}
</script>