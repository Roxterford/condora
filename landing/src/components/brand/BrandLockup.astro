---
/**
 * Lockup de marca. Usa el SVG oficial del panel tal cual
 * (`apps/panel/public/condora.svg`), igual que hacen el sidebar y el login,
 * para que la marca se vea idéntica en los dos productos.
 *
 * El nombre visible viene del texto alternativo, no de una capa de texto
 * encima: así el buscador indexa "Condora" y el logo es decorativo.
 */
interface Props {
	href?: string
	/** Altura en rem. El lockup mide 517:100. */
	size?: number
	/**
	 * Deja que la altura se recorte sola en pantallas muy estrechas en vez de
	 * dejar que el flexbox la aplaste. Solo el encabezado lo necesita: es la
	 * única fila que comparte ancho con un control de tamaño fijo.
	 */
	fluid?: boolean
	/** `blanco` carga la variante monocroma para fondos oscuros. */
	variant?: 'color' | 'blanco'
	class?: string
}

const {
	href = '/',
	size = 1.75,
	fluid = false,
	variant = 'color',
	class: className = '',
} = Astro.props
const src = variant === 'blanco' ? '/condora_blanco.svg' : '/condora.svg'

/**
 * El alto disponible en el encabezado es el ancho de la ventana menos lo que
 * la fila ya gasta: gutter (2 × 1.25rem), hueco del flexbox (0.75rem) y el
 * botón de menú (2.25rem). Lo que sobra, dividido entre la proporción 517:100
 * del propio lockup, es la altura máxima que cabe sin empujar nada.
 *
 * El `min()` mantiene el tamaño de diseño en cuanto hay sitio de sobra: por
 * debajo de ~245px de ventana es el `min()` el que manda y el logo se reduce
 * en vez de desaparecer.
 */
const height = fluid
	? `min(${size}rem, calc((100vw - 5.25rem) / 5.17))`
	: `${size}rem`
---

<a
	href={href}
	class:list={[
		'brand-lockup inline-flex shrink-0 items-center rounded-md no-underline',
		className,
	]}
	aria-label="Condora, ir al inicio"
>
	<img
		src={src}
		alt="Condora"
		width="517"
		height="100"
		loading="eager"
		decoding="sync"
		class="shrink-0"
		style={`height:${height};width:auto`}
	/>
</a>

<style>
	.brand-lockup {
		transition: opacity 0.3s var(--ease-brand);
	}

	.brand-lockup:hover,
	.brand-lockup:focus-visible {
		opacity: 0.75;
	}

	@media (prefers-reduced-motion: reduce) {
		.brand-lockup {
			transition: none;
		}
	}
</style>