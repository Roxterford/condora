# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars

# PostgreSQL service defined in .devcontainer/docker-compose.yml. Use `postgres` as host from
# inside the devcontainer; from the host machine the port is published, so use `localhost`.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

SECRET_KEY="MY_ULTRA_SECRET_KEY"
DATABASE_URL="postgresql://condominio:condominio@postgres:5432/condominio"

# Redis
REDIS_HOST="redis"
REDIS_PORT="6379"

NEXT_PORT=4000

MAX_MESES_FUTURO_CUOTA=1

# Panel (Next.js) -> endpoint de la API GraphQL
# GRAPHQL_ENDPOINT se usa en el servidor (SSR, server actions, codegen).
# NEXT_PUBLIC_GRAPHQL_ENDPOINT se inyecta en el bundle del navegador y es
# OBLIGATORIA si el panel se sirve en un dominio distinto al de la API.
# Dentro del devcontainer usá el nombre del servicio; desde el host, localhost.
GRAPHQL_ENDPOINT="http://localhost:8081/query"
NEXT_PUBLIC_GRAPHQL_ENDPOINT="http://localhost:8081/query"
