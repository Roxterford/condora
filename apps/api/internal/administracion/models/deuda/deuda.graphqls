enum EstadoDeDeuda {
  PENDIENTE
  ABONADA
  SALDADA
}

type Deuda__Titular {
  id: ID!
  email: String!
  telefono: String!
  cedula: String!
  display_name: String!
}

interface Deuda__Cuota {
  id: ID!
  nombre: String!
  monto: Float!
  mes: Mes!
  anio: Int!
  registro: DateTime!
  actualizacion: DateTime!
}
type Deuda__CuotaRegular implements Deuda__Cuota {
  id: ID!
  nombre: String!
  monto: Float!
  mes: Mes!
  anio: Int!
  registro: DateTime!
  actualizacion: DateTime!
}

type Deuda__CuotaEspecial implements Deuda__Cuota {
  id: ID!
  nombre: String!
  monto: Float!
  mes: Mes!
  anio: Int!
  registro: DateTime!
  actualizacion: DateTime!
}

type Deuda__CuotaSemilla implements Deuda__Cuota {
  id: ID!
  nombre: String!
  monto: Float!
  mes: Mes!
  anio: Int!
  registro: DateTime!
  actualizacion: DateTime!
}

union Deuda__CuotaType = Deuda__CuotaRegular | Deuda__CuotaEspecial | Deuda__CuotaSemilla

input DeudaFilter @autofilter {
  cuota: StringCondition
  unidad: StringCondition
  estado: StringCondition
  # Code generated by tools/autofilter/autofilter.go
  and: [DeudaFilter!] # injected by @autofilter
  or: [DeudaFilter!] # injected by @autofilter
  not: DeudaFilter # injected by @autofilter
}

type Deuda @paginable {
  id: String!
  estado: EstadoDeDeuda!
  cuota: Deuda__CuotaType!
  unidad: UnidadIdentifiers!
  titular: Deuda__Titular
  monto: Float!
  deuda: Float!
  abonos: [Abono!]
  registro: DateTime!
}
# Code generated by tools/autopaginated/main.go
type PaginatedDeuda {
  data: [Deuda!]!
  total: Int!
  page: Int!
  pages: Int!
  limit: Int!
}
